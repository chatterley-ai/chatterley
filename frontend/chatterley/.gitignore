# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python distribution files
python-dist/

# local wheel/runtime artifacts (populated during release builds)
python-wheels/*
!python-wheels/**/
!python-wheels/**/.gitkeep
python-wheels/**/*.whl
python-wheels/**/*.zip
python-wheels/vllm/**
!python-wheels/vllm/
!python-wheels/vllm/.gitkeep
!python-wheels/vllm/**/.gitkeep
windows-runners/*
!windows-runners/**/
!windows-runners/**/.gitkeep
windows-runners/**/*.zip
windows-runners/**/*.dll
